{
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true
  },
  "include": [
    "src/**/*",
    "socket/src/**/*",
    "shared/**/*",
    "prisma/seet.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
