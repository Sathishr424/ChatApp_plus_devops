# =========================
# Control Plane Security Group
# =========================

resource "aws_security_group" "k8s_control_plane" {
  name        = "k8s-control-plane"
  description = "Security group for Kubernetes control plane"

  # Outbound
  egress {
    description = "Allow all outbound traffic"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "k8s-control-plane"
  }
}


# =========================
# Worker Security Group
# =========================

resource "aws_security_group" "k8s_workers" {
  name        = "k8s-workers"
  description = "Security group for Kubernetes worker nodes"

  # Outbound
  egress {
    description = "Allow all outbound traffic"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "k8s-workers"
  }
}


# ============================================================
# CONTROL PLANE INGRESS RULES
# ============================================================

# Workers -> Kubernetes API Server
resource "aws_vpc_security_group_ingress_rule" "workers_to_api_server" {
  security_group_id            = aws_security_group.k8s_control_plane.id
  referenced_security_group_id = aws_security_group.k8s_workers.id

  description   = "Workers to Kubernetes API server"
  from_port     = 6443
  to_port       = 6443
  ip_protocol   = "tcp"
}


# Workers -> Control Plane Kubelet
resource "aws_vpc_security_group_ingress_rule" "workers_to_control_plane_kubelet" {
  security_group_id            = aws_security_group.k8s_control_plane.id
  referenced_security_group_id = aws_security_group.k8s_workers.id

  description = "Workers to control plane kubelet"
  from_port   = 10250
  to_port     = 10250
  ip_protocol = "tcp"
}


# Control Plane -> etcd
resource "aws_vpc_security_group_ingress_rule" "control_plane_etcd" {
  security_group_id            = aws_security_group.k8s_control_plane.id
  referenced_security_group_id = aws_security_group.k8s_control_plane.id

  description = "Control plane etcd"
  from_port   = 2379
  to_port     = 2380
  ip_protocol = "tcp"
}


# Control Plane -> kube-controller-manager
resource "aws_vpc_security_group_ingress_rule" "control_plane_controller_manager" {
  security_group_id            = aws_security_group.k8s_control_plane.id
  referenced_security_group_id = aws_security_group.k8s_control_plane.id

  description = "Control plane kube-controller-manager"
  from_port   = 10257
  to_port     = 10257
  ip_protocol = "tcp"
}


# Control Plane -> kube-scheduler
resource "aws_vpc_security_group_ingress_rule" "control_plane_scheduler" {
  security_group_id            = aws_security_group.k8s_control_plane.id
  referenced_security_group_id = aws_security_group.k8s_control_plane.id

  description = "Control plane kube-scheduler"
  from_port   = 10259
  to_port     = 10259
  ip_protocol = "tcp"
}


# SSH -> Control Plane
resource "aws_vpc_security_group_ingress_rule" "control_plane_ssh" {
  security_group_id = aws_security_group.k8s_control_plane.id

  description = "SSH access to control plane"
  cidr_ipv4   = "183.82.24.223/32"
  from_port   = 22
  to_port     = 22
  ip_protocol = "tcp"
}


# Your machine -> Kubernetes API Server
resource "aws_vpc_security_group_ingress_rule" "admin_to_api_server" {
  security_group_id = aws_security_group.k8s_control_plane.id

  description = "kubectl access to Kubernetes API server"
  cidr_ipv4   = "183.82.24.223/32"
  from_port   = 6443
  to_port     = 6443
  ip_protocol = "tcp"
}


# ============================================================
# WORKER INGRESS RULES
# ============================================================

# Control Plane -> Worker Kubelet
resource "aws_vpc_security_group_ingress_rule" "control_plane_to_workers_kubelet" {
  security_group_id            = aws_security_group.k8s_workers.id
  referenced_security_group_id = aws_security_group.k8s_control_plane.id

  description = "Control plane to worker kubelet"
  from_port   = 10250
  to_port     = 10250
  ip_protocol = "tcp"
}


# Worker -> Worker kube-proxy
resource "aws_vpc_security_group_ingress_rule" "workers_kube_proxy" {
  security_group_id            = aws_security_group.k8s_workers.id
  referenced_security_group_id = aws_security_group.k8s_workers.id

  description = "Worker to worker kube-proxy"
  from_port   = 10256
  to_port     = 10256
  ip_protocol = "tcp"
}


# Worker -> Worker Calico VXLAN
resource "aws_vpc_security_group_ingress_rule" "workers_calico_vxlan" {
  security_group_id            = aws_security_group.k8s_workers.id
  referenced_security_group_id = aws_security_group.k8s_workers.id

  description = "Calico VXLAN between workers"
  from_port   = 4789
  to_port     = 4789
  ip_protocol = "udp"
}


# NodePort services
resource "aws_vpc_security_group_ingress_rule" "workers_nodeport" {
  security_group_id = aws_security_group.k8s_workers.id

  description = "Kubernetes NodePort services"
  cidr_ipv4   = "0.0.0.0/0"
  from_port   = 30000
  to_port     = 32767
  ip_protocol = "tcp"
}


# SSH -> Workers
resource "aws_vpc_security_group_ingress_rule" "workers_ssh" {
  security_group_id = aws_security_group.k8s_workers.id

  description = "SSH access to workers"
  cidr_ipv4   = "183.82.24.223/32"
  from_port   = 22
  to_port     = 22
  ip_protocol = "tcp"
}
