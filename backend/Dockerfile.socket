FROM node:22.23.3-alpine3.24 AS builder

WORKDIR /app

COPY package*.json ./

RUN npm ci

COPY . .

RUN npm run build-socket

FROM node:22.23.3-alpine3.24 AS production

WORKDIR /app

RUN apk add --no-cache curl

COPY package*.json ./

RUN npm ci --omit=dev

COPY --from=builder /app/socket-dist ./dist

# COPY --from=builder /app/prisma ./prisma

EXPOSE 5002

COPY docker-entrypoint-socket.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

ENTRYPOINT ["docker-entrypoint.sh"]
