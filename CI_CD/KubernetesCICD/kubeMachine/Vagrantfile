Vagrant.configure("2") do |config|
  config.vm.define "master" do |master|
    master.vm.box = "bento/ubuntu-24.04"
    master.vm.hostname = "master"
    master.vm.synced_folder "/mnt/sat/Learning/Devops/kubernetes/KubeMachines/", "/home/vagrant/shared"
    master.vm.network "private_network", ip: "192.168.56.41"
    master.vm.provider "virtualbox" do |vb|
      vb.memory = "4096"
      vb.cpus = 4
    end

    master.vm.provision "shell", path: "scripts/global.sh"

    master.vm.provision "shell", path: "scripts/master.sh"
  end

  config.vm.define "worker1" do |worker1|
    worker1.vm.box = "bento/ubuntu-24.04"
    worker1.vm.hostname = "worker1"
    worker1.vm.network "private_network", ip: "192.168.56.42"
    worker1.vm.provider "virtualbox" do |vb|
      vb.memory = "2048"
      vb.cpus = 2
    end

    worker1.vm.provision "shell", path: "scripts/global.sh"
  end

  config.vm.define "worker2" do |worker2|
    worker2.vm.box = "bento/ubuntu-24.04"
    worker2.vm.hostname = "worker2"
    worker2.vm.network "private_network", ip: "192.168.56.43"
    worker2.vm.provider "virtualbox" do |vb|
      vb.memory = "2048"
      vb.cpus = 2
    end

    worker2.vm.provision "shell", path: "scripts/global.sh"
  end
end
