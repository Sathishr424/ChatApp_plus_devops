# =========================
# Backend / Socket / Storage
# =========================

CLIENT_URL="http://localhost"

DATABASE_URL="postgresql://<db-username>:<db-password>@chat-db:5432/chat?schema=public"

JWT_SECRET="your_jwt_secret_here"

REDIS_URL="redis://redis:6379"

# It's for sending out notification emails
MAIL_USERNAME=
MAIL_PASSWORD=

# =========================
# PostgreSQL
# =========================

POSTGRES_DB=chat
POSTGRES_USER=<db-username>
POSTGRES_PASSWORD=<db-password>
